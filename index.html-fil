<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Global Live Transit Tracker</title>
    <link rel="stylesheet" href="https://unpkg.com" />
    <script src="https://unpkg.com"></script>
    <style>
        body, html { margin: 0; padding: 0; height: 100%; width: 100%; font-family: Arial, sans-serif; }
        #map { height: 100vh; width: 100vw; }
        .loading-box { position: absolute; top: 10px; right: 10px; background: white; padding: 10px; z-index: 1000; border-radius: 5px; box-shadow: 0 0 10px rgba(0,0,0,0.3); font-weight: bold; }
    </style>
</head>
<body>

    <div class="loading-box" id="status">Henter live data...</div>
    <div id="map"></div>

    <script>
        var map = L.map('map').setView([55.6761, 12.5683], 8);
        
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap'
        }).addTo(map);

        var markersGroup = L.layerGroup().addTo(map);

        async function fetchLiveTransit() {
            document.getElementById('status').innerText = "Opdaterer data...";
            markersGroup.clearLayers();

            // FLY DATA - Nu sendt igennem en gratis CORS-proxy for at undgå blokering
            try {
                const targetUrl = 'https://opensky-network.org';
                const proxyUrl = 'https://allorigins.win' + encodeURIComponent(targetUrl);
                
                const response = await fetch(proxyUrl);
                const rawData = await response.json();
                const flyData = JSON.parse(rawData.contents); // Pakker dataen ud af proxyen
                
                if (flyData && flyData.states) {
                    flyData.states.forEach(flight => {
                        let callsign = flight[1] ? flight[1].trim() : "Ukendt Fly";
                        let lng = flight[5];
                        let lat = flight[6];
                        let altitude = flight[7] ? Math.round(flight[7] * 3.28084) + " fod" : "Ukendt";

                        if (lat && lng) {
                            // Tilføjer et direkte link til LiveATC lufthavnsradio i popup-boksen
                            L.circleMarker([lat, lng], { color: 'blue', fillColor: '#3388ff', fillOpacity: 0.8, radius: 7 })
                             .addTo(markersGroup)
                             .bindPopup(`<b>✈️ Fly: ${callsign}</b><br>Højde: ${altitude}<br><br><a href="https://liveatc.net" target="_blank" style="color:blue; font-weight:bold;">🎧 Lyt til Flyradio (CPH Tower)</a>`);
                        }
                    });
                }
            } catch (e) { 
                console.error(e);
                document.getElementById('status').innerText = "Fejl ved hentning af fly"; 
            }

            // SIMULERET SKIB/BUS/TOG DATA (Klikbare test-ikoner)
            const demoData = [
                { type: "🚢 Skib", name: "DFDS Pearl Seaways", lat: 56.12, lng: 12.30, info: "Kurs: Oslo", link: "https://broadcastify.com" },
                { type: "🚆 Tog", name: "IC 214 (DSB)", lat: 55.64, lng: 12.01, info: "Mod: Høje Taastrup", link: "#" },
                { type: "🚌 Bus", name: "Movia Linje 5C", lat: 55.68, lng: 12.56, info: "Mod: Københavns Lufthavn", link: "#" }
            ];

            demoData.forEach(item => {
                let color = item.type.includes('Skib') ? 'purple' : item.type.includes('Tog') ? 'red' : 'green';
                let radioText = item.type.includes('Skib') ? `<br><a href="${item.link}" target="_blank" style="color:purple;">🎧 Søg efter Maritim VHF Radio</a>` : "<br><i>Lyd utilgængelig (Krypteret SINE-netværk)</i>";
                
                L.circleMarker([item.lat, item.lng], { color: color, fillColor: color, fillOpacity: 0.8, radius: 7 })
                 .addTo(markersGroup)
                 .bindPopup(`<b>${item.type}: ${item.name}</b><br>${item.info}${radioText}`);
            });

            document.getElementById('status').innerText = "Live (Opdateret)";
        }

        // Opdaterer hvert 30. sekund
        setInterval(fetchLiveTransit, 30000);
        fetchLiveTransit();
    </script>
</body>
</html>
